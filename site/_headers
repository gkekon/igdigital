# Cache — οι σελίδες ΔΕΝ αποθηκεύονται (ώστε κάθε deploy να φαίνεται αμέσως),
# τα αρχεία με σταθερό περιεχόμενο αποθηκεύονται.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/uploads/*
  Cache-Control: public, max-age=604800

/og/*
  Cache-Control: public, max-age=604800

/support.js
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800
